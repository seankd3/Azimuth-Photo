[Unit]
Description=Azimuth Photo catalog restore drill
After=network-online.target

[Service]
Type=oneshot
User=azimuth
Group=azimuth
WorkingDirectory=/opt/azimuth-photo
EnvironmentFile=-/etc/azimuth-photo/azimuth-photo.env
ExecStart=/opt/azimuth-photo/.venv/bin/python /opt/azimuth-photo/scripts/restore_drill.py --notify --scratch-parent /var/tmp
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
