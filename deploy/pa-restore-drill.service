[Unit]
Description=Azimuth Photo catalog restore drill
After=network-online.target

[Service]
Type=oneshot
User=sean
WorkingDirectory=/home/sean/Projects/photo-archive
ExecStart=/home/sean/Projects/photo-archive/scripts/restore_drill.py --notify --scratch-parent /var/tmp
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
