[Unit]
Description=Azimuth Photo library server
Wants=network-online.target
After=network-online.target local-fs.target

[Service]
Type=simple
User=azimuth
Group=azimuth
WorkingDirectory=/opt/azimuth-photo
EnvironmentFile=-/etc/azimuth-photo/azimuth-photo.env
Environment=PYTHONUNBUFFERED=1
Environment=AZIMUTH_MODE=hub
Environment=AZIMUTH_ACCESS=local
Environment=AZIMUTH_HOST=127.0.0.1
Environment=AZIMUTH_PORT=8000
Environment=AZIMUTH_DATA_DIR=/var/lib/azimuth-photo
Environment=AZIMUTH_CONFIG_DIR=/var/lib/azimuth-photo/config
Environment=AZIMUTH_CACHE_DIR=/var/cache/azimuth-photo
Environment=AZIMUTH_STATE_DIR=/var/lib/azimuth-photo/state
Environment=AZIMUTH_DB_PATH=/var/lib/azimuth-photo/catalog/azimuth.db
Environment=AZIMUTH_MODELS_DIR=/var/lib/azimuth-photo/models
Environment=AZIMUTH_THUMB_CACHE_DIR=/var/cache/azimuth-photo/previews
Environment=AZIMUTH_EMBED_CACHE_DIR=/var/cache/azimuth-photo/embeddings
Environment=AZIMUTH_DEVELOP_CACHE_DIR=/var/cache/azimuth-photo/develop
Environment=AZIMUTH_TRANSFER_DIR=/var/lib/azimuth-photo/state/transfer
Environment=AZIMUTH_BACKUP_DIR=/var/lib/azimuth-photo/backups
Environment=AZIMUTH_SYNC_INTAKE_DIR=/srv/photos/_intake
Environment=AZIMUTH_SYNC_RAWS_DIR=/srv/photos/RAWS
Environment=AZIMUTH_SSD_CACHE_BYTES=53687091200
Environment=AZIMUTH_BULK_HDD_CONCURRENCY=1
ExecStart=/opt/azimuth-photo/.venv/bin/python /opt/azimuth-photo/scripts/server_entry.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
KillMode=mixed
UMask=0027
LimitNOFILE=65536
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=6

[Install]
WantedBy=multi-user.target
