# Copy to /etc/azimuth-photo/azimuth-photo.env and adapt it to your storage.
# The systemd unit contains safe single-machine defaults; values here override
# them for a networked hub with originals on a separate durable volume.

AZIMUTH_ACCESS=tailscale
AZIMUTH_HOST=100.64.0.10
AZIMUTH_PORT=8000

AZIMUTH_SYNC_INTAKE_DIR=/srv/photos/_intake
AZIMUTH_SYNC_RAWS_DIR=/srv/photos/RAWS
AZIMUTH_BACKUP_DIR=/srv/azimuth-backups

# Keep latency-sensitive data on SSD even when originals live on a slow HDD.
AZIMUTH_DATA_DIR=/var/lib/azimuth-photo
AZIMUTH_CACHE_DIR=/var/cache/azimuth-photo
AZIMUTH_STATE_DIR=/var/lib/azimuth-photo/state
AZIMUTH_SSD_CACHE_BYTES=53687091200
AZIMUTH_BULK_HDD_CONCURRENCY=1
