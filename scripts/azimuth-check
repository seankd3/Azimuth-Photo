#!/usr/bin/env bash
# One check for the whole tree.
#
#   ./scripts/azimuth-check          lint, the suite, the gates, the ledger
#   ./scripts/azimuth-check --quick  lint and the gates only, a few seconds
#
# Everything here fails loudly and finishes in well under a minute; a check
# that does not get run protects nothing.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VENV="${AZIMUTH_VENV:-$ROOT/web/.venv}"
PYTHON="$VENV/bin/python"
[[ -x "$PYTHON" ]] || PYTHON="$VENV/Scripts/python.exe"
[[ -x "$PYTHON" ]] || { echo "azimuth-check: no interpreter in $VENV (install web/requirements-v2.txt and web/requirements-dev.txt)" >&2; exit 2; }

cd "$ROOT"
git diff --check
"$ROOT/scripts/lint"
"$PYTHON" scripts/gates/check.py

if [[ "${1:-}" == "--quick" ]]; then
    echo "azimuth-check: quick ok"
    exit 0
fi

(cd web && "$PYTHON" -m pytest -q -p no:cacheprovider .)
for spec in web/test_v2_*.mjs; do
    node "$spec"
done
"$PYTHON" scripts/rewrite_status.py --check
# The build opens: a window over a small library draws it and throws nothing.
# Needs a desktop (the window builds the document itself when a source is
# newer); a headless runner builds it here and opens nothing.
if [[ "${OS:-}" == "Windows_NT" && "${AZIMUTH_NO_WINDOW:-}" == "" ]]; then
    "$PYTHON" scripts/smoke_boot.py
else
    "$PYTHON" scripts/build_desktop_ui.py >/dev/null
fi
echo "azimuth-check: ok"
