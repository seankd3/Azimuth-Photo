#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
WEB="$ROOT/web"
DEFAULT_VENV="$WEB/.venv"
if [[ -x "${XDG_DATA_HOME:-$HOME/.local/share}/azimuth-photo/venv/bin/python" ]]; then
    DEFAULT_VENV="${XDG_DATA_HOME:-$HOME/.local/share}/azimuth-photo/venv"
fi
VENV="${AZIMUTH_VENV:-$DEFAULT_VENV}"
PYTHON="$VENV/bin/python"
RUNTIME_RUN_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/azimuth-photo/run"
RUNTIME_LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/azimuth-photo/logs"
if [[ -x "$PYTHON" ]]; then
    mapfile -t RUNTIME_PATHS < <(
        PYTHONPATH="$WEB" "$PYTHON" -c \
            'from core.runtime_paths import resolve_runtime_paths; p = resolve_runtime_paths(); print(p.run_dir); print(p.log_dir)'
    )
    RUNTIME_RUN_DIR="${RUNTIME_PATHS[0]:-$RUNTIME_RUN_DIR}"
    RUNTIME_LOG_DIR="${RUNTIME_PATHS[1]:-$RUNTIME_LOG_DIR}"
fi
RUN_DIR="$RUNTIME_RUN_DIR"
PIDFILE="$RUN_DIR/azimuth.pid"
LOGFILE="$RUNTIME_LOG_DIR/server.log"
MAX_LOG_BYTES="${AZIMUTH_MAX_LOG_BYTES:-10485760}"
ACCESS="${AZIMUTH_ACCESS:-local}"
resolve_tailscale_host() {
    if ! command -v tailscale >/dev/null 2>&1; then
        echo "AZIMUTH_ACCESS=tailscale requires the tailscale CLI." >&2
        return 1
    fi
    local ip
    ip="$(tailscale ip -4 2>/dev/null | head -n 1 | tr -d '[:space:]')"
    if [[ -z "$ip" ]]; then
        echo "Tailscale is not ready. Start Tailscale before starting Azimuth Photo in tailscale mode." >&2
        return 1
    fi
    printf '%s\n' "$ip"
}

if [[ "$ACCESS" == "tailscale" ]]; then
    HOST="${AZIMUTH_HOST:-$(resolve_tailscale_host)}"
else
    HOST="${AZIMUTH_HOST:-127.0.0.1}"
fi
PORT="${AZIMUTH_PORT:-8000}"
# Startup trusts a clean-shutdown marker to skip a full multi-GB integrity
# scan. Give model and background-task teardown enough time to write it before
# falling back to SIGKILL; callers can still override this for emergencies.
STOP_TIMEOUT_SECONDS="${AZIMUTH_STOP_TIMEOUT_SECONDS:-60}"
URL="http://${HOST}:${PORT}"
export AZIMUTH_ACCESS="$ACCESS"
export AZIMUTH_HOST="$HOST" AZIMUTH_PORT="$PORT"
UVICORN="$VENV/bin/uvicorn"
PYTHON_MATCH_PATTERN="$VENV/bin/python .*uvicorn app:app --host ${HOST} --port ${PORT}"
UVICORN_MATCH_PATTERN="$VENV/bin/uvicorn app:app --host ${HOST} --port ${PORT}"

mkdir -p "$RUN_DIR" "$RUNTIME_LOG_DIR"

rotate_log_if_needed() {
    [[ -f "$LOGFILE" ]] || return 0
    local bytes
    bytes="$(wc -c <"$LOGFILE" 2>/dev/null || echo 0)"
    [[ "$bytes" =~ ^[0-9]+$ ]] || bytes=0
    if (( bytes > MAX_LOG_BYTES )); then
        tail -c "$MAX_LOG_BYTES" "$LOGFILE" >"${LOGFILE}.tmp"
        mv "${LOGFILE}.tmp" "$LOGFILE"
    fi
}

find_pids() {
    {
        pgrep -f "$PYTHON_MATCH_PATTERN" 2>/dev/null || true
        pgrep -f "$UVICORN_MATCH_PATTERN" 2>/dev/null || true
    } | sort -u
}

is_healthy() {
    curl -fsS --max-time 1 "$URL/api/dev/status" >/dev/null 2>&1
}

print_status() {
    local pids
    pids="$(find_pids | tr '\n' ' ' | sed 's/[[:space:]]*$//')"
    printf 'repo: %s\n' "$ROOT"
    printf 'url:  %s\n' "$URL"
    if [[ "$ACCESS" == "tailscale" ]] && command -v tailscale >/dev/null 2>&1; then
        local dns_name
        dns_name="$(tailscale status --json 2>/dev/null | python -c 'import json,sys; data=json.load(sys.stdin); print((data.get("Self") or {}).get("DNSName", "").rstrip("."))' 2>/dev/null || true)"
        if [[ -n "$dns_name" ]]; then
            printf 'tail: http://%s:%s\n' "$dns_name" "$PORT"
        fi
    fi
    printf 'log:  %s\n' "$LOGFILE"
    if [[ -n "$pids" ]]; then
        printf 'pids: %s\n' "$pids"
    else
        printf 'pids: none\n'
    fi

    if command -v curl >/dev/null 2>&1; then
        if curl -fsS --max-time 1 "$URL/api/dev/status"; then
            printf '\n'
        else
            printf 'health: not responding to /api/dev/status\n'
        fi
    fi
}

stop_server() {
    local pids deadline remaining
    pids="$(find_pids)"
    if [[ -z "$pids" ]]; then
        echo "No Azimuth Photo server found for ${URL}."
        return 0
    fi

    echo "$pids" | xargs -r kill -TERM
    deadline=$((SECONDS + STOP_TIMEOUT_SECONDS))
    while [[ $SECONDS -lt $deadline ]]; do
        remaining="$(find_pids)"
        [[ -z "$remaining" ]] && break
        sleep 0.25
    done

    remaining="$(find_pids)"
    if [[ -n "$remaining" ]]; then
        echo "$remaining" | xargs -r kill -KILL
        for _ in {1..20}; do
            [[ -z "$(find_pids)" ]] && break
            sleep 0.1
        done
    fi
    rm -f "$PIDFILE"
}

start_server() {
    if [[ ! -x "$UVICORN" ]]; then
        echo "Missing $UVICORN. Set AZIMUTH_VENV or run the documented setup." >&2
        return 1
    fi

    if [[ -n "$(find_pids)" ]] || is_healthy; then
        echo "Azimuth Photo already appears to be running on ${URL}." >&2
        print_status
        return 1
    fi

    rotate_log_if_needed

    (
        cd "$WEB"
        if command -v setsid >/dev/null 2>&1; then
            nohup setsid "$UVICORN" app:app --host "$HOST" --port "$PORT" --no-access-log >>"$LOGFILE" 2>&1 </dev/null &
        else
            nohup "$UVICORN" app:app --host "$HOST" --port "$PORT" --no-access-log >>"$LOGFILE" 2>&1 </dev/null &
        fi
        echo "$!" >"$PIDFILE"
    )

    for _ in {1..160}; do
        is_healthy && break
        sleep 0.25
    done

    print_status
}

case "${1:-status}" in
    start)
        start_server
        ;;
    stop)
        stop_server
        ;;
    restart)
        stop_server
        start_server
        ;;
    status)
        print_status
        ;;
    logs)
        touch "$LOGFILE"
        tail -f "$LOGFILE"
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status|logs}" >&2
        exit 2
        ;;
esac
