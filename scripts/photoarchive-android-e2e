#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
APP_ID="app.azimuthphoto.mobile"
MAIN_ACTIVITY="${APP_ID}/.MainActivity"
PORT="${PHOTOARCHIVE_PORT:-8000}"
ARTIFACT_DIR="${PHOTOARCHIVE_ANDROID_E2E_ARTIFACTS:-$ROOT/outputs/android-e2e}"
REQUIRE_DEVICE=0
ADB="${ADB:-}"
DEVICE_SERIAL="${PHOTOARCHIVE_ANDROID_DEVICE:-}"

usage() {
    cat <<'USAGE'
Usage: photoarchive-android-e2e [--require-device] [--adb PATH] [--device SERIAL]

Starts or verifies the Omarchy photoArchive server, builds the Android APK
against the verified Tailscale URL, and, when adb plus a device are available,
installs and launches the app, captures a screenshot, dumps the UI tree, and
fails if the app lands in an offline state.

Without a connected device, it still runs a no-phone Android smoke test through
Robolectric against the live local photoArchive server.

Environment:
  PHOTOARCHIVE_PORT                  Server port, default 8000.
  PHOTOARCHIVE_ANDROID_SERVER_URL    Override tested server URL.
  PHOTOARCHIVE_ANDROID_DEVICE        adb serial to target.
  PHOTOARCHIVE_ANDROID_E2E_ARTIFACTS Artifact directory.
USAGE
}

while (($#)); do
    case "$1" in
        --require-device)
            REQUIRE_DEVICE=1
            ;;
        --adb)
            if [[ $# -lt 2 || "$2" == --* ]]; then
                echo "--adb requires a path." >&2
                exit 2
            fi
            ADB="$2"
            shift
            ;;
        --device)
            if [[ $# -lt 2 || "$2" == --* ]]; then
                echo "--device requires an adb serial." >&2
                exit 2
            fi
            DEVICE_SERIAL="$2"
            shift
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        *)
            echo "Unknown argument: $1" >&2
            usage >&2
            exit 2
            ;;
    esac
    shift
done

mkdir -p "$ARTIFACT_DIR"

tailscale_dns_name() {
    tailscale status --json 2>/dev/null | "$ROOT/web/.venv/bin/python" -c '
import json, sys
data = json.load(sys.stdin)
print(((data.get("Self") or {}).get("DNSName") or "").rstrip("."))
'
}

tailscale_ip() {
    tailscale ip -4 2>/dev/null | head -n 1 | tr -d '[:space:]'
}

server_url() {
    if [[ -n "${PHOTOARCHIVE_ANDROID_SERVER_URL:-}" ]]; then
        printf '%s\n' "$PHOTOARCHIVE_ANDROID_SERVER_URL"
        return
    fi
    local dns
    dns="$(tailscale_dns_name)"
    if [[ -n "$dns" ]]; then
        printf 'http://%s:%s\n' "$dns" "$PORT"
        return
    fi
    local ip
    ip="$(tailscale_ip)"
    if [[ -n "$ip" ]]; then
        printf 'http://%s:%s\n' "$ip" "$PORT"
        return
    fi
    printf 'http://127.0.0.1:%s\n' "$PORT"
}

health_url_for_host() {
    local ip
    ip="$(tailscale_ip)"
    if [[ -n "$ip" ]]; then
        printf 'http://%s:%s/api/rankings?limit=1&sort=date_taken\n' "$ip" "$PORT"
    else
        printf '%s/api/rankings?limit=1&sort=date_taken\n' "$SERVER_URL"
    fi
}

require_server() {
    local health_url="$1"
    if curl -fsS --max-time 4 "$health_url" >"$ARTIFACT_DIR/server-health.json"; then
        return
    fi

    echo "Starting photoArchive for Android e2e..."
    PHOTOARCHIVE_ACCESS=tailscale PHOTOARCHIVE_PORT="$PORT" "$ROOT/scripts/photoarchive-server" start >/tmp/photoarchive-android-e2e-server.log 2>&1 || true

    for _ in {1..80}; do
        if curl -fsS --max-time 4 "$health_url" >"$ARTIFACT_DIR/server-health.json"; then
            return
        fi
        sleep 0.5
    done

    echo "photoArchive did not become reachable at $health_url" >&2
    cat /tmp/photoarchive-android-e2e-server.log >&2 || true
    exit 1
}

require_local_server() {
    local local_url="http://127.0.0.1:${PORT}/api/rankings?limit=1&sort=date_taken"
    if curl -fsS --max-time 4 "$local_url" >"$ARTIFACT_DIR/server-local-health.json"; then
        return
    fi

    echo "Starting local photoArchive for no-phone Android smoke..."
    PHOTOARCHIVE_ACCESS=local PHOTOARCHIVE_PORT="$PORT" "$ROOT/scripts/photoarchive-server" start >/tmp/photoarchive-android-local-server.log 2>&1 || true

    for _ in {1..80}; do
        if curl -fsS --max-time 4 "$local_url" >"$ARTIFACT_DIR/server-local-health.json"; then
            return
        fi
        sleep 0.5
    done

    echo "photoArchive did not become reachable at $local_url" >&2
    cat /tmp/photoarchive-android-local-server.log >&2 || true
    exit 1
}

find_adb() {
    if [[ -n "$ADB" && -x "$ADB" ]]; then
        printf '%s\n' "$ADB"
        return 0
    fi
    if command -v adb >/dev/null 2>&1; then
        command -v adb
        return 0
    fi
    local candidate
    candidate="$(find "$HOME/Android/Sdk" -path '*/platform-tools/adb' -type f -perm -111 2>/dev/null | head -n 1 || true)"
    if [[ -n "$candidate" ]]; then
        printf '%s\n' "$candidate"
        return 0
    fi
    return 1
}

adb_prefix() {
    if [[ -n "$DEVICE_SERIAL" ]]; then
        printf '%q -s %q' "$ADB_BIN" "$DEVICE_SERIAL"
    else
        printf '%q' "$ADB_BIN"
    fi
}

device_count() {
    if [[ -n "$DEVICE_SERIAL" ]]; then
        "$ADB_BIN" devices | awk -v serial="$DEVICE_SERIAL" '$1 == serial && $2 == "device" { found = 1 } END { print found + 0 }'
    else
        "$ADB_BIN" devices | awk 'NR > 1 && $2 == "device" { count++ } END { print count + 0 }'
    fi
}

run_device_smoke() {
    local apk="$ROOT/android/app/build/outputs/apk/debug/app-debug.apk"
    local adb_cmd
    adb_cmd="$(adb_prefix)"

    eval "$adb_cmd install -r '$apk'" >"$ARTIFACT_DIR/adb-install.log"
    eval "$adb_cmd shell pm clear '$APP_ID'" >/dev/null
    eval "$adb_cmd shell am start -n '$MAIN_ACTIVITY'" >"$ARTIFACT_DIR/adb-start.log"
    sleep 7

    eval "$adb_cmd exec-out screencap -p" >"$ARTIFACT_DIR/screenshot.png" || true
    eval "$adb_cmd shell uiautomator dump /sdcard/photoarchive-window.xml" >"$ARTIFACT_DIR/uiautomator.log" || true
    eval "$adb_cmd exec-out cat /sdcard/photoarchive-window.xml" >"$ARTIFACT_DIR/window.xml" || true
    eval "$adb_cmd logcat -d -t 400" >"$ARTIFACT_DIR/logcat.txt" || true

    if grep -Eiq 'Offline|Cannot reach|Import failed|crash|fatal exception' "$ARTIFACT_DIR/window.xml" "$ARTIFACT_DIR/logcat.txt"; then
        echo "Android e2e failed. See $ARTIFACT_DIR." >&2
        exit 1
    fi

    if ! grep -Eiq 'Connected privately|photos available|Archive|Search' "$ARTIFACT_DIR/window.xml"; then
        echo "Android e2e could not confirm the app reached a useful state. See $ARTIFACT_DIR." >&2
        exit 1
    fi
}

run_no_phone_smoke() {
    require_local_server
    echo "Running no-phone Android app smoke against http://127.0.0.1:${PORT}..."
    PHOTOARCHIVE_ANDROID_SERVER_URL="http://127.0.0.1:${PORT}" "$ROOT/scripts/photoarchive-android-build" \
        -PphotoArchiveDefaultServerUrl="http://127.0.0.1:${PORT}" \
        :app:testDebugUnitTest \
        >"$ARTIFACT_DIR/no-phone-smoke.log" 2>&1 || {
            cat "$ARTIFACT_DIR/no-phone-smoke.log" >&2
            exit 1
        }
}

SERVER_URL="$(server_url)"
HEALTH_URL="$(health_url_for_host)"

echo "Server URL for APK: $SERVER_URL"
echo "Host health check:   $HEALTH_URL"
require_server "$HEALTH_URL"
run_no_phone_smoke

PHOTOARCHIVE_ANDROID_SERVER_URL="$SERVER_URL" "$ROOT/scripts/photoarchive-android-build" \
    -PphotoArchiveDefaultServerUrl="$SERVER_URL" \
    :app:assembleDebug

cp "$ROOT/android/app/build/outputs/apk/debug/app-debug.apk" "$ROOT/outputs/photoarchive-android-debug.apk"
sha256sum "$ROOT/outputs/photoarchive-android-debug.apk" >"$ARTIFACT_DIR/apk.sha256"

ADB_BIN="$(find_adb 2>/dev/null || true)"
ADB_BIN="$(printf '%s' "$ADB_BIN" | head -n 1)"
if [[ -z "$ADB_BIN" ]]; then
    if [[ "$REQUIRE_DEVICE" == 1 ]]; then
        echo "adb is required for device e2e but was not found." >&2
        echo "Install Android platform-tools on Omarchy or pass --adb /path/to/adb." >&2
        exit 1
    fi
    echo "No adb found. Server and APK gates passed; device smoke skipped."
    echo "Install Android platform-tools and rerun with --require-device for full unattended e2e."
    exit 0
fi

"$ADB_BIN" start-server >/dev/null
if [[ "$(device_count)" == "0" ]]; then
    if [[ "$REQUIRE_DEVICE" == 1 ]]; then
        echo "adb is installed, but no Android device is connected/authorized." >&2
        "$ADB_BIN" devices >&2
        exit 1
    fi
    echo "No adb device found. Server and APK gates passed; device smoke skipped."
    "$ADB_BIN" devices
    exit 0
fi

run_device_smoke
echo "Android e2e passed. Artifacts: $ARTIFACT_DIR"
