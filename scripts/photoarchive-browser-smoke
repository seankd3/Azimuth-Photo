const VISIBLE_PAGE_STATE_SCRIPT = `(() => {
    const defineGetter = (target, property, value) => {
        try {
            Object.defineProperty(target, property, {
                configurable: true,
                get: () => value,
            });
        } catch (_error) {
            // Best effort for headless tabs that otherwise stay backgrounded.
        }
    };
    defineGetter(Document.prototype, "hidden", false);
    defineGetter(Document.prototype, "visibilityState", "visible");
    if (globalThis.document) {
        defineGetter(globalThis.document, "hidden", false);
        defineGetter(globalThis.document, "visibilityState", "visible");
    }
    if (typeof globalThis.setTimeout === "function" && !globalThis.__photoArchiveSmokeSetTimeoutWrapped) {
        const originalSetTimeout = globalThis.setTimeout.bind(globalThis);
        globalThis.__photoArchiveSmokeSetTimeoutWrapped = true;
        globalThis.__photoArchiveSmokeTimers = [];
        let nextSmokeTimerId = 1;
        globalThis.setTimeout = (callback, delayMs, ...args) => {
            const delay = Number(delayMs) || 0;
            const stack = (new Error().stack || "").split("\\n").slice(1, 5).join(" | ");
            const shouldTrace = (
                stack.includes("/static/js/ai/poller.js") ||
                stack.includes("startAIStatusPolling") ||
                delay === 750 ||
                delay === 5000 ||
                delay === 30000
            );
            let record = null;
            if (shouldTrace) {
                record = {
                    id: nextSmokeTimerId++,
                    delay,
                    fired: false,
                    stack,
                    createdAt: Date.now(),
                };
                globalThis.__photoArchiveSmokeTimers.push(record);
                globalThis.__photoArchiveSmokeTimers = globalThis.__photoArchiveSmokeTimers.slice(-20);
            }
            return originalSetTimeout((...callbackArgs) => {
                if (record) {
                    record.fired = true;
                    record.firedAt = Date.now();
                }
                return callback(...callbackArgs);
            }, delayMs, ...args);
        };
    }
    if (typeof globalThis.fetch === "function" && !globalThis.__photoArchiveSmokeFetchWrapped) {
        const originalFetch = globalThis.fetch.bind(globalThis);
        globalThis.__photoArchiveSmokeFetchWrapped = true;
        globalThis.__photoArchiveSmokeAiStatusResponses = [];
        globalThis.fetch = async (...args) => {
            let aiStatusRecord = null;
            try {
                const input = args[0];
                const rawUrl = typeof input === "string" ? input : input?.url || "";
                const parsed = new URL(rawUrl, globalThis.location?.href || "http://127.0.0.1/");
                if (parsed.pathname === "/api/ai/status") {
                    aiStatusRecord = {
                        status: "pending",
                        url: parsed.href,
                        startedAt: Date.now(),
                    };
                    globalThis.__photoArchiveSmokeAiStatusResponses.push(aiStatusRecord);
                }
            } catch (_error) {
                // Network-level CDP checks still cover malformed cases.
            }
            const response = await originalFetch(...args);
            try {
                const input = args[0];
                const rawUrl = typeof input === "string" ? input : input?.url || "";
                const parsed = new URL(rawUrl, globalThis.location?.href || "http://127.0.0.1/");
                if (parsed.pathname === "/api/ai/status") {
                    const record = aiStatusRecord || {
                        url: parsed.href,
                        startedAt: Date.now(),
                    };
                    record.status = response.status;
                    record.finishedAt = Date.now();
                    if (!aiStatusRecord) {
                        globalThis.__photoArchiveSmokeAiStatusResponses.push(record);
                    }
                }
            } catch (_error) {
                // Network-level CDP checks still cover malformed cases.
            }
            return response;
        };
    }
})();`;

function usage() {
    return [
        "Usage: photoarchive-browser-smoke [--base-url URL]",
        "",
        `Default URL: ${DEFAULT_BASE_URL}`,
        "PHOTOARCHIVE_SMOKE_URL can also set the base URL.",
        "For local live smoke, start the server with PHOTOARCHIVE_SMOKE_MODE=1",
        "to suppress heavyweight startup warmers and background model workers.",
    ].join("\n");
}

function parseArgs(argv) {
    let baseUrl = process.env.PHOTOARCHIVE_SMOKE_URL || DEFAULT_BASE_URL;
    for (let index = 0; index < argv.length; index += 1) {
        const arg = argv[index];
        if (arg === "--help" || arg === "-h") {
            console.log(usage());
            process.exit(0);
        }
        if (arg === "--base-url") {
            index += 1;
            if (index >= argv.length) {
                throw new Error("--base-url requires a value");
            }
            baseUrl = argv[index];
            continue;
        }
        if (arg.startsWith("--base-url=")) {
            baseUrl = arg.slice("--base-url=".length);
            continue;
        }
        throw new Error(`Unknown argument: ${arg}`);
    }
    return normalizeBaseUrl(baseUrl);
}

function normalizeBaseUrl(value) {
    let parsed;
    try {
        parsed = new URL(value || DEFAULT_BASE_URL);
    } catch (error) {
        throw new Error(`Invalid base URL ${JSON.stringify(value)}: ${error.message}`);
    }
    parsed.hash = "";
    parsed.search = "";
    return parsed.href.replace(/\/$/, "");
}

function absoluteUrl(baseUrl, pagePath) {
    return new URL(pagePath, `${baseUrl}/`).href;
}

function delay(ms) {
    return new Promise((resolve) => setTimeout(resolve, ms));
}

function compactText(value) {
    return String(value).replace(/\s+/g, " ").trim();
}

function formatRemoteObject(object) {
    if (!object) {
        return "";
    }
    if (Object.prototype.hasOwnProperty.call(object, "value")) {
        return compactText(object.value);
    }
    if (object.description) {
        return compactText(object.description);
    }
    if (object.unserializableValue) {
        return compactText(object.unserializableValue);
    }
    return object.type || "";
}

function formatException(details) {
    if (!details) {
        return "unknown exception";
    }
    const exception = details.exception;
    const text = exception ? formatRemoteObject(exception) : compactText(details.text || "");
    const location = [
        details.url || "",
        Number.isFinite(details.lineNumber) ? details.lineNumber + 1 : "",
        Number.isFinite(details.columnNumber) ? details.columnNumber + 1 : "",
    ].filter(Boolean).join(":");
    return location ? `${text} (${location})` : text;
}

function isStaticJs(urlText) {
    try {
        const url = new URL(urlText);
        return url.pathname.startsWith("/static/") && url.pathname.endsWith(".js");
    } catch (_error) {
        return false;
    }
}

function isAIStatusUrl(urlText) {
    try {
        const url = new URL(urlText);
        return url.pathname === "/api/ai/status";
    } catch (_error) {
        return false;
    }
}

async function fetchTextWithTimeout(url, timeoutMs, options = {}) {
    const controller = new AbortController();
    const timer = setTimeout(() => controller.abort(), timeoutMs);
    try {
        const response = await globalThis.fetch(url, {
            ...options,
            signal: controller.signal,
        });
        return {
            response,
            bodyText: await response.text(),
        };
    } catch (error) {
        if (error?.name === "AbortError") {
            throw new Error(`GET ${url} timed out after ${timeoutMs}ms`);
        }
        throw error;
    } finally {
        clearTimeout(timer);
    }
}

async function checkDevStatus(baseUrl) {
    const statusUrl = absoluteUrl(baseUrl, "/api/dev/status");
    let result;
    try {
        result = await fetchTextWithTimeout(statusUrl, 5000, {
            headers: { accept: "application/json" },
        });
    } catch (error) {
        throw new Error(`GET ${statusUrl} failed: ${error.message}`);
    }
    const { response, bodyText } = result;
    if (!response.ok) {
        throw new Error(`GET ${statusUrl} returned HTTP ${response.status}: ${bodyText.slice(0, 300)}`);
    }
    let payload = {};
    try {
        payload = JSON.parse(bodyText);
    } catch (error) {
        throw new Error(`GET ${statusUrl} did not return JSON: ${error.message}`);
    }
    console.log(
        `dev status ok: pid=${payload.pid ?? "unknown"} git=${payload.git_commit ?? "unknown"}`
    );
}

async function prewarmAIStatus(baseUrl) {
    const statusUrl = absoluteUrl(baseUrl, "/api/ai/status");
    let result;
    try {
        result = await fetchTextWithTimeout(statusUrl, AI_STATUS_PREWARM_TIMEOUT_MS, {
            headers: { accept: "application/json" },
        });
    } catch (error) {
        throw new Error(`GET ${statusUrl} failed during AI status prewarm: ${error.message}`);
    }
    const { response, bodyText } = result;
    if (!response.ok) {
        throw new Error(`GET ${statusUrl} returned HTTP ${response.status} during AI status prewarm: ${bodyText.slice(0, 300)}`);
    }
    console.log(`ai status prewarm ok: HTTP ${response.status}`);
}

async function freeLocalPort() {
    return new Promise((resolve, reject) => {
        const server = net.createServer();
        server.once("error", reject);
        server.listen(0, "127.0.0.1", () => {
            const address = server.address();
            const port = address && typeof address === "object" ? address.port : null;
            server.close(() => {
                if (port) {
                    resolve(port);
                } else {
                    reject(new Error("Failed to reserve a local Chrome debugging port"));
                }
            });
        });
    });
}

async function launchChrome() {
    const userDataDir = await fs.mkdtemp(path.join(os.tmpdir(), "photoarchive-browser-smoke-"));
    const debugPort = await freeLocalPort();
    const debugVersionUrl = `http://127.0.0.1:${debugPort}/json/version`;
    const args = [
        "--headless=new",
        "--remote-debugging-address=127.0.0.1",
        `--remote-debugging-port=${debugPort}`,
        `--user-data-dir=${userDataDir}`,
        "--no-sandbox",
        "--no-first-run",
        "--no-default-browser-check",
        "--remote-allow-origins=*",
        "about:blank",
    ];
    const child = spawn(CHROME_BIN, args, { stdio: ["ignore", "pipe", "pipe"] });
    let output = "";
    try {
        const wsUrl = await new Promise((resolve, reject) => {
            let settled = false;
            let poll = null;
            const finish = (callback, value) => {
                if (settled) {
                    return;
                }
                settled = true;
                clearTimeout(timer);
                if (poll) clearInterval(poll);
                callback(value);
            };
            const onData = (chunk) => {
                output += chunk.toString();
            };
            const timer = setTimeout(() => {
                finish(reject, new Error(`Timed out waiting for Chrome DevTools endpoint at ${debugVersionUrl}:\n${output}`));
            }, CHROME_DEVTOOLS_TIMEOUT_MS);
            poll = setInterval(async () => {
                try {
                    const response = await globalThis.fetch(debugVersionUrl);
                    if (!response.ok) {
                        return;
                    }
                    const version = await response.json();
                    if (version.webSocketDebuggerUrl) {
                        finish(resolve, version.webSocketDebuggerUrl);
                    }
                } catch (_error) {
                    // Chrome is still starting.
                }
            }, 100);
            child.once("error", (error) => {
                finish(reject, new Error(`Failed to launch ${CHROME_BIN}: ${error.message}`));
            });
            child.once("exit", (code, signal) => {
                finish(reject, new Error(`${CHROME_BIN} exited before DevTools was ready: ${code ?? signal}\n${output}`));
            });
            child.stdout.on("data", onData);
            child.stderr.on("data", onData);
        });
        return { child, userDataDir, wsUrl };
    } catch (error) {
        await stopChrome({ child, userDataDir });
        throw error;
    }
}

async function stopChrome(chrome) {
    if (!chrome) {
        return;
    }
    const { child, userDataDir } = chrome;
    if (child && !child.killed && child.exitCode === null) {
        child.kill("SIGTERM");
        await Promise.race([
            new Promise((resolve) => child.once("exit", resolve)),
            delay(2000).then(() => {
                if (child.exitCode === null) {
                    child.kill("SIGKILL");
                }
            }),
        ]);
    }
    if (userDataDir) {
        await fs.rm(userDataDir, {
            recursive: true,
            force: true,
            maxRetries: 5,
            retryDelay: 100,
        });
    }
}

class CdpConnection {
    constructor(ws) {
        this.ws = ws;
        this.nextId = 1;
        this.pending = new Map();
        this.handlers = new Set();
        this.closed = false;
        this.ws.addEventListener("message", (event) => this.handleMessage(event));
        this.ws.addEventListener("close", () => this.rejectAll(new Error("CDP WebSocket closed")));
        this.ws.addEventListener("error", () => this.rejectAll(new Error("CDP WebSocket error")));
    }

    static connect(wsUrl) {
        if (typeof globalThis.WebSocket !== "function") {
            throw new Error("This smoke harness requires a Node runtime with built-in WebSocket support.");
        }
        return new Promise((resolve, reject) => {
            const ws = new globalThis.WebSocket(wsUrl);
            let settled = false;
            const finish = (callback, value) => {
                if (settled) {
                    return;
                }
                settled = true;
                clearTimeout(timer);
                callback(value);
            };
            const timer = setTimeout(() => {
                finish(reject, new Error("Timed out connecting to Chrome DevTools WebSocket"));
            }, 10000);
            ws.addEventListener("open", () => finish(resolve, new CdpConnection(ws)));
            ws.addEventListener("error", () => finish(reject, new Error("Chrome DevTools WebSocket connection failed")));
            ws.addEventListener("close", () => finish(reject, new Error("Chrome DevTools WebSocket closed during connect")));
        });
    }

    handleMessage(event) {
        const text = typeof event.data === "string"
            ? event.data
            : Buffer.from(event.data).toString("utf8");
        const message = JSON.parse(text);
        if (message.id) {
            const pending = this.pending.get(message.id);
            if (!pending) {
                return;
            }
            this.pending.delete(message.id);
            if (message.error) {
                pending.reject(new Error(`${message.error.message}: ${message.error.data || ""}`));
            } else {
                pending.resolve(message.result || {});
            }
            return;
        }
        for (const handler of Array.from(this.handlers)) {
            handler(message);
        }
    }

    rejectAll(error) {
        if (this.closed) {
            return;
        }
        this.closed = true;
        for (const pending of this.pending.values()) {
            pending.reject(error);
        }
        this.pending.clear();
    }

    send(method, params = {}, sessionId = undefined) {
        if (this.closed) {
            return Promise.reject(new Error(`Cannot send ${method}; CDP connection is closed`));
        }
        const id = this.nextId;
        this.nextId += 1;
        const message = { id, method, params };
        if (sessionId) {
            message.sessionId = sessionId;
        }
        return new Promise((resolve, reject) => {
            this.pending.set(id, { resolve, reject });
            this.ws.send(JSON.stringify(message));
        });
    }

    onEvent(handler) {
        this.handlers.add(handler);
        return () => this.handlers.delete(handler);
    }

    waitForEvent(method, sessionId, timeoutMs) {
        return new Promise((resolve, reject) => {
            const timer = setTimeout(() => {
                unsubscribe();
                reject(new Error(`Timed out waiting for ${method}`));
            }, timeoutMs);
            const unsubscribe = this.onEvent((message) => {
                if (message.method === method && (!sessionId || message.sessionId === sessionId)) {
                    clearTimeout(timer);
                    unsubscribe();
                    resolve(message.params || {});
                }
            });
        });
    }

    close() {
        try {
            this.ws.close();
        } catch (_error) {
            // Best effort close.
        }
    }
}

function collectPageIssue(message, issues, staticJsRequests, aiStatusResponses) {
    const { method, params = {} } = message;
    if (method === "Runtime.exceptionThrown") {
        issues.push(`runtime exception: ${formatException(params.exceptionDetails)}`);
        return;
    }
    if (method === "Runtime.consoleAPICalled" && params.type === "error") {
        const args = (params.args || []).map(formatRemoteObject).filter(Boolean).join(" ");
        issues.push(`console error: ${args || "console.error called"}`);
        return;
    }
    if (method === "Log.entryAdded") {
        const entry = params.entry || {};
        if (entry.level === "error" && ["javascript", "console-api"].includes(entry.source)) {
            issues.push(`log error: ${entry.text || "unknown log error"}`);
        }
        return;
    }
    if (method === "Network.requestWillBeSent" && isStaticJs(params.request?.url || "")) {
        staticJsRequests.set(params.requestId, params.request.url);
        return;
    }
    if (method === "Network.responseReceived") {
        const responseUrl = params.response?.url || "";
        const url = staticJsRequests.get(params.requestId);
        const status = params.response?.status || 0;
        if (aiStatusResponses && isAIStatusUrl(responseUrl)) {
            aiStatusResponses.push({
                status,
                url: responseUrl,
            });
        }
        if (url && status >= 400) {
            issues.push(`static js HTTP ${status}: ${url}`);
        }
        return;
    }
    if (method === "Network.loadingFailed") {
        const url = staticJsRequests.get(params.requestId);
        if (url) {
            issues.push(`static js load failed: ${url} (${params.errorText || "unknown error"})`);
        }
    }
}

async function evaluate(cdp, sessionId, expression, description) {
    const response = await cdp.send("Runtime.evaluate", {
        expression,
        awaitPromise: true,
        returnByValue: true,
    }, sessionId);
    if (response.exceptionDetails) {
        throw new Error(`${description}: ${formatException(response.exceptionDetails)}`);
    }
    return response.result?.value;
}

function readinessExpression(pagePath) {
    return `(() => {
        const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
        return (async () => {
            const deadline = Date.now() + 8000;
            while (!window.PhotoArchiveReady && Date.now() < deadline) {
                await sleep(50);
            }
            if (!window.PhotoArchiveReady || typeof window.PhotoArchiveReady.then !== "function") {
                throw new Error("window.PhotoArchiveReady was not installed");
            }
            const readyState = await Promise.race([
                window.PhotoArchiveReady.then(
                    () => "resolved",
                    (error) => {
                        throw new Error("window.PhotoArchiveReady rejected: " + (error?.message || error));
                    },
                ),
                sleep(8000).then(() => "pending"),
            ]);
            const api = window.PhotoArchive || {};
            const missing = ${JSON.stringify(REQUIRED_API)}.filter((name) => typeof api[name] !== "function");
            if (missing.length) {
                throw new Error("window.PhotoArchive is missing functions: " + missing.join(", "));
            }
            const selectors = ${JSON.stringify(PAGE_SENTINELS[pagePath] || [])};
            const missingSelectors = selectors.filter((selector) => !document.querySelector(selector));
            if (missingSelectors.length) {
                throw new Error("missing page sentinels: " + missingSelectors.join(", "));
            }
            if (${JSON.stringify(pagePath)} === "/compare") {
                const panel = document.querySelector("#ai-panel");
                const wasHidden = panel?.classList.contains("hidden");
                api.toggleAIPanel();
                const toggledHidden = panel?.classList.contains("hidden");
                api.toggleAIPanel();
                const restoredHidden = panel?.classList.contains("hidden");
                if (wasHidden === toggledHidden || restoredHidden !== wasHidden) {
                    throw new Error("PhotoArchive.toggleAIPanel did not toggle and restore #ai-panel");
                }
            }
            return {
                title: document.title,
                readyState: document.readyState,
                photoArchiveReady: readyState,
            };
        })();
    })()`;
}

function workflowProbeExpression(pagePath) {
    return `(() => {
        const pagePath = ${JSON.stringify(pagePath)};
        const workflows = ${JSON.stringify(SMOKE_WORKFLOW_CONTRACT)}.filter((workflow) => (
            (workflow.pagePaths || []).includes(pagePath)
        ));
        const api = window.PhotoArchive || {};
        const missing = [];
        for (const workflow of workflows) {
            const selectors = [
                ...(workflow.selectors || []),
                ...((workflow.pageSelectors || {})[pagePath] || []),
            ];
            const missingSelectors = selectors.filter((selector) => !document.querySelector(selector));
            if (missingSelectors.length) {
                missing.push(\`\${workflow.name} selectors: \${missingSelectors.join(", ")}\`);
            }
            const missingApi = (workflow.api || []).filter((name) => typeof api[name] !== "function");
            if (missingApi.length) {
                missing.push(\`\${workflow.name} API: \${missingApi.join(", ")}\`);
            }
        }
        if (missing.length) {
            throw new Error("smoke workflow contract failed: " + missing.join("; "));
        }
        return {
            workflowNames: workflows.map((workflow) => workflow.name),
            checked: workflows.length,
        };
    })()`;
}

function formatAIStatusResponses(responses) {
    if (!responses.length) {
        return "none";
    }
    return responses
        .map((response) => `${response.status || "unknown"} ${response.url || "/api/ai/status"}`)
        .join(", ");
}

async function pageAIStatusResponses(cdp, sessionId, pagePath) {
    try {
        const responses = await evaluate(
            cdp,
            sessionId,
            "globalThis.__photoArchiveSmokeAiStatusResponses || []",
            `${pagePath} AI status fetch log`
        );
        return Array.isArray(responses) ? responses : [];
    } catch (_error) {
        return [];
    }
}

async function pageAIStatusDebug(cdp, sessionId, pagePath) {
    try {
        return await evaluate(
            cdp,
            sessionId,
            `(() => ({
                hidden: document.hidden,
                visibilityState: document.visibilityState,
                initState: globalThis.__photoArchiveInitState || null,
                fetchWrapped: Boolean(globalThis.__photoArchiveSmokeFetchWrapped),
                timeoutWrapped: Boolean(globalThis.__photoArchiveSmokeSetTimeoutWrapped),
                timers: globalThis.__photoArchiveSmokeTimers || [],
                aiResponses: globalThis.__photoArchiveSmokeAiStatusResponses || [],
                aiCountText: document.querySelector("#ai-embed-count")?.textContent || "",
                rankingCards: document.querySelectorAll(".ranking-card, .ranking-item").length,
                hasPhotoArchive: Boolean(globalThis.PhotoArchive),
                hasReady: Boolean(globalThis.PhotoArchiveReady && typeof globalThis.PhotoArchiveReady.then === "function"),
            }))()`,
            `${pagePath} AI status debug snapshot`
        );
    } catch (error) {
        return { error: error.message };
    }
}

async function waitForAIStatusResponse(
    cdp,
    sessionId,
    pagePath,
    aiStatusResponses,
    timeoutMs = AI_STATUS_TIMEOUT_MS
) {
    const deadline = Date.now() + timeoutMs;
    let observedResponses = aiStatusResponses;
    while (Date.now() < deadline) {
        observedResponses = [
            ...aiStatusResponses,
            ...await pageAIStatusResponses(cdp, sessionId, pagePath),
        ];
        const okResponse = observedResponses.find((response) => (
            response.status >= 200 && response.status < 300
        ));
        if (okResponse) {
            return okResponse;
        }
        await delay(100);
    }
    const debug = await pageAIStatusDebug(cdp, sessionId, pagePath);
    throw new Error(
        `${pagePath} did not observe a 2xx /api/ai/status response ` +
        `(observed: ${formatAIStatusResponses(observedResponses)}; debug=${JSON.stringify(debug)})`
    );
}

function aiStatusDomSnapshotExpression(pagePath) {
    const selectors = AI_STATUS_FIELD_SELECTORS[pagePath] || [];
    return `(() => {
        const selectors = ${JSON.stringify(selectors)};
        const placeholderTexts = new Set(["", "-", String.fromCharCode(0x2014)]);
        const fields = selectors.map((selector) => {
            const element = document.querySelector(selector);
            const text = (element?.textContent || "").replace(/\\s+/g, " ").trim();
            return {
                selector,
                present: Boolean(element),
                text,
            };
        });
        const updated = fields.filter((field) => (
            field.present && !placeholderTexts.has(field.text)
        ));
        return {
            ok: updated.length > 0,
            fields,
            updated,
        };
    })()`;
}

function aiStatusPollerNudgeExpression() {
    return `(() => {
        const defineGetter = (target, property, value) => {
            try {
                Object.defineProperty(target, property, {
                    configurable: true,
                    get: () => value,
                });
            } catch (_error) {
                // Some browser-owned visibility properties are best effort only.
            }
        };
        defineGetter(Document.prototype, "hidden", false);
        defineGetter(Document.prototype, "visibilityState", "visible");
        defineGetter(document, "hidden", false);
        defineGetter(document, "visibilityState", "visible");
        if (typeof globalThis.fetch === "function" && !globalThis.__photoArchiveSmokeFetchWrapped) {
            const originalFetch = globalThis.fetch.bind(globalThis);
            globalThis.__photoArchiveSmokeFetchWrapped = true;
            globalThis.__photoArchiveSmokeAiStatusResponses = [];
            globalThis.fetch = async (...args) => {
                const response = await originalFetch(...args);
                try {
                    const input = args[0];
                    const rawUrl = typeof input === "string" ? input : input?.url || "";
                    const parsed = new URL(rawUrl, globalThis.location?.href || "http://127.0.0.1/");
                    if (parsed.pathname === "/api/ai/status") {
                        globalThis.__photoArchiveSmokeAiStatusResponses.push({
                            status: response.status,
                            url: parsed.href,
                        });
                    }
                } catch (_error) {
                    // CDP network events are the fallback.
                }
                return response;
            };
        }
        document.dispatchEvent(new Event("visibilitychange"));
        return {
            hidden: document.hidden,
            visibilityState: document.visibilityState,
            wrapped: Boolean(globalThis.__photoArchiveSmokeFetchWrapped),
            responseCount: (globalThis.__photoArchiveSmokeAiStatusResponses || []).length,
        };
    })()`;
}

function formatAIStatusFields(snapshot) {
    const fields = snapshot?.fields || [];
    if (!fields.length) {
        return "none";
    }
    return fields
        .map((field) => {
            const value = field.present ? field.text : "<missing>";
            return `${field.selector}=${JSON.stringify(value)}`;
        })
        .join(", ");
}

async function waitForAIStatusDomUpdate(cdp, sessionId, pagePath, timeoutMs = AI_STATUS_TIMEOUT_MS) {
    const deadline = Date.now() + timeoutMs;
    let snapshot = null;
    while (Date.now() < deadline) {
        snapshot = await evaluate(
            cdp,
            sessionId,
            aiStatusDomSnapshotExpression(pagePath),
            `${pagePath} AI status DOM snapshot`
        );
        if (snapshot?.ok) {
            return snapshot;
        }
        await delay(100);
    }
    throw new Error(
        `${pagePath} AI status DOM fields stayed placeholder/empty after /api/ai/status ` +
        `(${formatAIStatusFields(snapshot)})`
    );
}

async function nudgeAIStatusPoller(cdp, sessionId, pagePath) {
    const state = await evaluate(
        cdp,
        sessionId,
        aiStatusPollerNudgeExpression(),
        `${pagePath} AI status poller visibility nudge`
    );
    if (state?.hidden || state?.visibilityState === "hidden") {
        throw new Error(
            `${pagePath} remained hidden after smoke visibility nudge ` +
            `(hidden=${state.hidden}, visibilityState=${state.visibilityState})`
        );
    }
    return state;
}

async function smokePage(cdp, baseUrl, pagePath) {
    const context = await cdp.send("Target.createBrowserContext");
    const browserContextId = context.browserContextId;
    const target = await cdp.send("Target.createTarget", {
        url: "about:blank",
        browserContextId,
    });
    const targetId = target.targetId;
    const attached = await cdp.send("Target.attachToTarget", { targetId, flatten: true });
    const sessionId = attached.sessionId;
    const issues = [];
    const staticJsRequests = new Map();
    const aiStatusResponses = [];
    const unsubscribe = cdp.onEvent((message) => {
        if (message.sessionId === sessionId) {
            collectPageIssue(message, issues, staticJsRequests, aiStatusResponses);
        }
    });
    try {
        await cdp.send("Runtime.enable", {}, sessionId);
        await cdp.send("Log.enable", {}, sessionId);
        await cdp.send("Network.enable", {}, sessionId);
        await cdp.send("Network.setCacheDisabled", { cacheDisabled: true }, sessionId);
        await cdp.send("Page.enable", {}, sessionId);
        await cdp.send("Page.addScriptToEvaluateOnNewDocument", {
            source: VISIBLE_PAGE_STATE_SCRIPT,
        }, sessionId);
        await cdp.send("Target.activateTarget", { targetId });
        await cdp.send("Page.bringToFront", {}, sessionId);

        const pageUrl = absoluteUrl(baseUrl, pagePath);
        const loadEvent = cdp.waitForEvent("Page.loadEventFired", sessionId, 15000);
        const nav = await cdp.send("Page.navigate", { url: pageUrl }, sessionId);
        if (nav.errorText) {
            throw new Error(`navigation failed: ${nav.errorText}`);
        }
        await loadEvent;
        let ready;
        try {
            ready = await evaluate(cdp, sessionId, readinessExpression(pagePath), `${pagePath} readiness`);
        } catch (error) {
            await delay(400);
            if (issues.length) {
                throw new Error(`${error.message}\n${issues.join("\n")}`);
            }
            throw error;
        }
        await delay(400);
        if (issues.length) {
            throw new Error(issues.join("\n"));
        }
        const workflowProbe = await evaluate(
            cdp,
            sessionId,
            workflowProbeExpression(pagePath),
            `${pagePath} workflow probe`
        );
        if (workflowProbe?.checked) {
            console.log(`workflow ok: ${pagePath} (${workflowProbe.workflowNames.join(", ")})`);
        }
        if (AI_STATUS_PAGE_PATHS.has(pagePath)) {
            await nudgeAIStatusPoller(cdp, sessionId, pagePath);
            const aiStatusResponse = await waitForAIStatusResponse(cdp, sessionId, pagePath, aiStatusResponses);
            const aiStatusDom = await waitForAIStatusDomUpdate(cdp, sessionId, pagePath);
            const updatedSelectors = aiStatusDom.updated.map((field) => field.selector).join(", ");
            console.log(
                `ai status ok: ${pagePath} (HTTP ${aiStatusResponse.status}, updated=${updatedSelectors})`
            );
        }
        console.log(`page ok: ${pagePath} (${ready.title || "untitled"}, ready=${ready.photoArchiveReady})`);
    } finally {
        unsubscribe();
        try {
            await cdp.send("Target.closeTarget", { targetId });
        } catch (_error) {
            // Target may already be closed after a hard navigation failure.
        }
        try {
            await cdp.send("Target.disposeBrowserContext", { browserContextId });
        } catch (_error) {
            // Context may already be gone if Chrome cleaned up after a crash.
        }
    }
}

async function main() {
    if (typeof globalThis.fetch !== "function") {
        throw new Error("This smoke harness requires a Node runtime with built-in fetch support.");
    }
    const baseUrl = parseArgs(process.argv.slice(2));
    await checkDevStatus(baseUrl);

    let chrome = null;
    let cdp = null;
    const cleanup = async () => {
        if (cdp) {
            cdp.close();
            cdp = null;
        }
        await stopChrome(chrome);
        chrome = null;
    };
    process.once("SIGINT", () => {
        cleanup().finally(() => process.exit(130));
    });
    process.once("SIGTERM", () => {
        cleanup().finally(() => process.exit(143));
    });

    try {
        chrome = await launchChrome();
        cdp = await CdpConnection.connect(chrome.wsUrl);
        for (const pagePath of PAGE_PATHS) {
            if (AI_STATUS_PAGE_PATHS.has(pagePath)) {
                await prewarmAIStatus(baseUrl);
            }
            await smokePage(cdp, baseUrl, pagePath);
        }
        console.log(`photoArchive browser smoke: PASS (${PAGE_PATHS.length} pages)`);
    } finally {
        await cleanup();
    }
}

main().catch((error) => {
    console.error(`photoArchive browser smoke: FAIL\n${error.stack || error.message}`);
    process.exit(1);
});
