#!/usr/bin/env bash
# azimuth-photo test gates — parallel by default, honest exits, no pipe swallowing.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
WEB="$ROOT/web"
RESULTS_DIR="${AZIMUTH_GATE_RESULTS:-$ROOT/receipts/gate}"
mkdir -p "$RESULTS_DIR"

# System Node first (Cursor's bundled node rejects --experimental-default-type).
# Local tmpfs/tmp for symlink + atomic-rename tests (expansion FS forbids symlinks).
export PATH="/usr/bin:/usr/local/bin:${PATH}"
export TMPDIR="${TMPDIR:-/tmp}"
export TMP="${TMP:-$TMPDIR}"
export TEMP="${TEMP:-$TMPDIR}"
# Keep QA scratch off the no-symlink expansion volume when TMPDIR is local.
if [[ -z "${AZIMUTH_QA_SCRATCH:-}" ]]; then
  export AZIMUTH_QA_SCRATCH="$TMPDIR/azimuth-photo/qa-harness"
fi
mkdir -p "$TMPDIR" "$AZIMUTH_QA_SCRATCH"

if [[ -x "$WEB/.venv/bin/python" ]]; then
  PYTHON="$WEB/.venv/bin/python"
elif [[ -x "$WEB/.venv/Scripts/python.exe" ]]; then
  PYTHON="$WEB/.venv/Scripts/python.exe" # Windows venv layout
elif [[ -x "$ROOT/../azimuth-photo/web/.venv/bin/python" ]]; then
  PYTHON="$ROOT/../azimuth-photo/web/.venv/bin/python"
else
  echo "gate: need web/.venv (or shared azimuth-photo/web/.venv)" >&2
  exit 2
fi

usage() {
  cat <<'EOF'
Usage: gate <quick|changed|full> [expr]

  quick    contract tier, then -n auto -m "not slow and not serial and not bench"
  changed  contract tier, then -k <expr> (expr required)
  full     everything -n auto (not serial/bench), then serial group -n0

Results land in receipts/gate/*.log — never rely on a piped exit code.
EOF
}

if [[ $# -lt 1 ]]; then
  usage >&2
  exit 2
fi

MODE="$1"
shift || true
STAMP="$(date +%Y%m%d-%H%M%S)"
LOG="$RESULTS_DIR/${MODE}-${STAMP}.log"
LAST="$RESULTS_DIR/last-${MODE}.log"

run_pytest() {
  local label="$1"
  shift
  echo "==> $label" | tee -a "$LOG"
  echo "+ $PYTHON -m pytest $*" | tee -a "$LOG"
  set +e
  "$PYTHON" -m pytest "$@" >>"$LOG" 2>&1
  local rc=$?
  set -e
  echo "==> $label exit=$rc" | tee -a "$LOG"
  return "$rc"
}

collect_count() {
  local expr="$1"
  "$PYTHON" -m pytest --collect-only -q -m "$expr" 2>/dev/null \
    | python3 -c 'import re,sys
text=sys.stdin.read()
for line in reversed(text.splitlines()):
    m=re.search(r"(\d+)(?:/\d+)? tests? collected", line)
    if m:
        print(m.group(1)); raise SystemExit(0)
raise SystemExit(1)'
}

assert_slow_partition() {
  # -m "not slow" + -m slow == full set (excluding bench which is always out of addopts).
  # Fan the three collects so quick stays under the 90s wall.
  local dir not_slow slow all
  dir="$(mktemp -d)"
  collect_count 'not slow and not bench' >"$dir/not_slow" &
  local p1=$!
  collect_count 'slow and not bench' >"$dir/slow" &
  local p2=$!
  collect_count 'not bench' >"$dir/all" &
  local p3=$!
  wait "$p1" "$p2" "$p3" || true
  not_slow="$(cat "$dir/not_slow" 2>/dev/null || true)"
  slow="$(cat "$dir/slow" 2>/dev/null || true)"
  all="$(cat "$dir/all" 2>/dev/null || true)"
  rm -rf "$dir"
  if [[ -z "$not_slow" || -z "$slow" || -z "$all" ]]; then
    echo "gate: could not collect marker counts (not_slow=$not_slow slow=$slow all=$all)" | tee -a "$LOG"
    return 2
  fi
  local sum=$((not_slow + slow))
  echo "gate: collect not_slow=$not_slow slow=$slow all=$all sum=$sum" | tee -a "$LOG"
  if [[ "$sum" -ne "$all" ]]; then
    echo "gate: slow partition broken: not_slow+slow ($sum) != all ($all)" | tee -a "$LOG"
    return 2
  fi
}

cd "$WEB"
: >"$LOG"
echo "gate mode=$MODE log=$LOG python=$PYTHON node=$(command -v node) TMPDIR=$TMPDIR" | tee -a "$LOG"

CONTRACT_FILES=(
  test_modular_contracts.py
  test_quiet_sources.py
  test_settings.py
  test_lr_bridge.py
  test_develop_lrcat.py
  test_sync_hub.py
  test_desktop_correctness.py
  test_mobile_contracts.py
  test_trash.py
  test_system_backups.py
  test_runtime_paths.py
  test_ui_contracts.py
)

# Prefer a capped worker count on a busy host — -n auto oversubscribes when
# load average is already high and slows the wall clock.
xdist_workers() {
  local cpus load
  cpus="$(nproc 2>/dev/null || echo 4)"
  load="$(awk '{printf "%d", $1}' /proc/loadavg 2>/dev/null || echo 0)"
  if (( load > cpus )); then
    echo $(( (cpus + 1) / 2 ))
  else
    echo auto
  fi
}

RC=0
WORKERS="$(xdist_workers)"
echo "gate xdist_workers=$WORKERS load=$(cut -d' ' -f1 /proc/loadavg)" | tee -a "$LOG"

case "$MODE" in
  quick)
    # Lint first: seconds, and a red file never reaches pytest.
    if [[ -x "$ROOT/scripts/lint" ]]; then
      echo "==> lint" | tee -a "$LOG"
      set +e
      "$ROOT/scripts/lint" >>"$LOG" 2>&1
      lint_rc=$?
      set -e
      echo "==> lint exit=$lint_rc" | tee -a "$LOG"
      if [[ $lint_rc -ne 0 ]]; then RC=$lint_rc; cp -f "$LOG" "$LAST" 2>/dev/null || true; echo "gate finished mode=$MODE exit=$RC log=$LOG" | tee -a "$LOG"; exit "$RC"; fi
    fi
    # Partition assert lives on full; quick stays under the 90s wall.
    # Limit contract collection to known files so import cost stays tiny.
    run_pytest "contract" -q --tb=short --disable-warnings -m contract "${CONTRACT_FILES[@]}" || RC=$?
    if [[ $RC -eq 0 ]]; then
      run_pytest "quick-parallel" -n "$WORKERS" -q --tb=line --disable-warnings -m "not slow and not serial and not bench and not contract" || RC=$?
    fi
    if [[ $RC -eq 0 ]]; then
      # Exit 5 = no tests collected; treat as success.
      set +e
      run_pytest "quick-serial" -n0 -q --tb=line --disable-warnings -m "serial and not slow and not bench"
      serial_rc=$?
      set -e
      if [[ $serial_rc -eq 5 ]]; then
        echo "gate: no serial-quick tests" | tee -a "$LOG"
      elif [[ $serial_rc -ne 0 ]]; then
        RC=$serial_rc
      fi
    fi
    ;;
  changed)
    if [[ $# -lt 1 || -z "${1:-}" ]]; then
      echo "gate changed requires a -k expression" >&2
      usage >&2
      exit 2
    fi
    EXPR="$1"
    run_pytest "contract" -q --tb=short --disable-warnings -m contract "${CONTRACT_FILES[@]}" || RC=$?
    if [[ $RC -eq 0 ]]; then
      run_pytest "changed" -q --tb=short --disable-warnings -k "$EXPR" || RC=$?
    fi
    ;;
  full)
    assert_slow_partition || RC=$?
    if [[ $RC -eq 0 ]]; then
      run_pytest "full-parallel" -n "$WORKERS" -q --tb=line --disable-warnings -m "not serial and not bench" || RC=$?
    fi
    if [[ $RC -eq 0 ]]; then
      set +e
      run_pytest "full-serial" -n0 -q --tb=line --disable-warnings -m "serial and not bench"
      serial_rc=$?
      set -e
      if [[ $serial_rc -eq 5 ]]; then
        echo "gate: no serial tests" | tee -a "$LOG"
      elif [[ $serial_rc -ne 0 ]]; then
        RC=$serial_rc
      fi
    else
      echo "gate: skipping serial group because parallel failed (exit=$RC)" | tee -a "$LOG"
    fi
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac

cp -f "$LOG" "$LAST"
echo "gate finished mode=$MODE exit=$RC log=$LOG" | tee -a "$LOG"
exit "$RC"
