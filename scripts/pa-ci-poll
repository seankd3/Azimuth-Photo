#!/usr/bin/env bash
# pa-ci-poll — when origin/develop moves, run gate full in ~/Projects/pa-ci
# and ntfy on red/green transitions (same channel as pa-watchdog).
set -euo pipefail

REPO="${PHOTOARCHIVE_CI_REPO:-/home/sean/Projects/photo-archive}"
TREE="${PHOTOARCHIVE_CI_TREE:-/home/sean/Projects/pa-ci}"
REF="${PHOTOARCHIVE_CI_REF:-origin/develop}"
NTFY="${PHOTOARCHIVE_CI_NTFY:-http://127.0.0.1:8091/azimuth-alerts}"
LOG="${PHOTOARCHIVE_CI_LOG:-/var/tmp/pa-ci.log}"
STATE="${PHOTOARCHIVE_CI_STATE:-/var/tmp/pa-ci.state}"
SHA_FILE="${PHOTOARCHIVE_CI_SHA:-/var/tmp/pa-ci.sha}"
GATE_RESULTS="${PHOTOARCHIVE_GATE_RESULTS:-/var/tmp/pa-ci-results}"

mkdir -p "$(dirname "$LOG")" "$GATE_RESULTS"

log() {
  local now
  now="$(date '+%F %T')"
  echo "$now $*" >>"$LOG"
  # keep log bounded
  if [[ -f "$LOG" ]]; then
    tail -n 5000 "$LOG" >"$LOG.tmp" && mv "$LOG.tmp" "$LOG"
  fi
}

notify() {
  local title="$1"
  local body="$2"
  local priority="${3:-default}"
  curl -s -m 5 -H "Title: $title" -H "Priority: $priority" -d "$body" "$NTFY" >/dev/null || true
}

if [[ ! -d "$TREE/.git" && ! -f "$TREE/.git" ]]; then
  log "error: CI tree missing at $TREE"
  exit 2
fi

# Refresh remote tip
git -C "$REPO" fetch --quiet origin develop 2>/dev/null || true
tip="$(git -C "$REPO" rev-parse "$REF" 2>/dev/null || true)"
if [[ -z "$tip" ]]; then
  log "error: cannot resolve $REF"
  exit 2
fi

prev_sha="$(cat "$SHA_FILE" 2>/dev/null || true)"
if [[ "$tip" == "$prev_sha" ]]; then
  log "noop tip=$tip"
  exit 0
fi

log "tip-change prev=${prev_sha:-none} tip=$tip — updating $TREE"
git -C "$TREE" fetch --quiet origin develop 2>/dev/null || true

# Only reset onto tips that already ship scripts/gate. Until testspeed merges,
# origin/develop may lack the gate — keep the previous tree and wait.
if git -C "$REPO" cat-file -e "$tip:scripts/gate" 2>/dev/null; then
  if ! git -C "$TREE" reset --hard "$tip" >/dev/null 2>&1; then
    git -C "$TREE" reset --hard "$REF" >/dev/null 2>&1 || true
  fi
else
  log "tip $tip lacks scripts/gate — keeping current tree, recording sha"
  echo "$tip" >"$SHA_FILE"
  exit 0
fi

# Shared venv for the suite
if [[ ! -e "$TREE/web/.venv" ]]; then
  ln -sfn /home/sean/Projects/photo-archive/web/.venv "$TREE/web/.venv"
fi

export PATH="/usr/bin:/usr/local/bin:${PATH}"
export TMPDIR="${TMPDIR:-/tmp}"
export TMP="$TMPDIR"
export TEMP="$TMPDIR"
export PHOTOARCHIVE_GATE_RESULTS="$GATE_RESULTS"

GATE="$TREE/scripts/gate"
if [[ ! -x "$GATE" ]]; then
  log "error: gate missing at $GATE after reset"
  prev_state="$(cat "$STATE" 2>/dev/null || echo ok)"
  echo bad >"$STATE"
  echo "$tip" >"$SHA_FILE"
  if [[ "$prev_state" == "ok" ]]; then
    notify "Azimuth CI red" "develop $tip — scripts/gate missing in CI tree" high
  fi
  exit 1
fi

set +e
"$GATE" full
rc=$?
set -e

fail_names=""
if [[ $rc -ne 0 ]]; then
  last="$(ls -1t "$GATE_RESULTS"/full-*.log 2>/dev/null | head -1 || true)"
  if [[ -n "$last" ]]; then
    fail_names="$(rg -N '^FAILED |^ERROR ' "$last" 2>/dev/null | sed 's/^FAILED //;s/^ERROR //' | head -40 | tr '\n' '; ' || true)"
  fi
fi

prev_state="$(cat "$STATE" 2>/dev/null || echo ok)"
echo "$tip" >"$SHA_FILE"

if [[ $rc -ne 0 ]]; then
  echo bad >"$STATE"
  log "red tip=$tip rc=$rc fails=$fail_names"
  if [[ "$prev_state" == "ok" ]]; then
    notify "Azimuth CI red" "develop ${tip:0:10} failed gate full: ${fail_names:-see $LOG}" high
  fi
  exit "$rc"
fi

echo ok >"$STATE"
log "green tip=$tip"
if [[ "$prev_state" == "bad" ]]; then
  notify "Azimuth CI green" "develop ${tip:0:10} recovered — gate full clean"
fi
exit 0
